{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔥 Dev: Backend (.NET Watch)",
      "type": "shell",
      "command": "dotnet watch run --project EnglishLearningApp/EnglishLearningApp.csproj --no-hot-reload",
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "⚡ Dev: Frontend (Next.js Dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 START DEV FULLSTACK (Hot Reload)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "🔥 Dev: Backend (.NET Watch)",
        "⚡ Dev: Frontend (Next.js Dev)"
      ],
      "problemMatcher": []
    }
  ]
}